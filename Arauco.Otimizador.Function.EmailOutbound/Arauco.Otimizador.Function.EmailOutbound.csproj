<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find project dependencies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Generate ready to run images during publishing to improve cold start time. -->
    
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Templates\nova-senha.html" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates\nova-senha.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.2.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" Version="3.0.0" />
	<PackageReference Include="Mustache" Version="1.0.1" />
	<PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.300.7" />
  </ItemGroup>
  <ItemGroup>
	<ProjectReference Include="..\Arauco.Otimizador.Common.Domain\Arauco.Otimizador.Common.Domain.csproj" />
	<ProjectReference Include="..\Arauco.Otimizador.Function.Base\Arauco.Otimizador.Function.Base.csproj" />
	<ProjectReference Include="..\Techer.Common.Extensions\Techer.Common.Extensions.csproj" />
	<ProjectReference Include="..\Techer.Common.Json\Techer.Common.Json.csproj" />
  </ItemGroup>
</Project>