<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Fonts\Arial-Bold.ttf" />
    <None Remove="Fonts\Arial.ttf" />
    <None Remove="Fonts\Poppins-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\Arial-Bold.ttf" />
    <EmbeddedResource Include="Fonts\Arial.ttf" />
    <EmbeddedResource Include="Fonts\Poppins-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

</Project>
